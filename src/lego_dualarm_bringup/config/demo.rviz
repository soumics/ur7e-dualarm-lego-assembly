Panels: []
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.25
      Plane Cell Count: 16
      Color: 160; 160; 164
      Alpha: 0.4
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: RGB-D point cloud (overhead D435)
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/points
      Color Transformer: RGB8
      Style: Points
      Size (Pixels): 1
      Alpha: 0.3
      Decay Time: 0
      Position Transformer: XYZ
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Baseplate
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lego/fixture_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Perceived bricks (/lego/detections)
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lego/detection_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Planner target (remaining)
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lego/target_markers
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    # Same viewpoint as the Gazebo GUI camera in demo_gui.config:
    # focal (0, -0.08, 0.80), distance 1.8, pitch 0.70, yaw 1.30 (scripts/demo_view.py moves both) (eye on the +y side; the camera
    # mast stands on the -y side and would block the view).
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 1.8
      Focal Point:
        X: 0
        Y: -0.08
        Z: 0.80
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Near Clip Distance: 0.01
      Pitch: 0.70
      Yaw: 1.30
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Hide Left Dock: true
  Hide Right Dock: true
  Height: 1400
  Width: 1280
  X: 1280
  Y: 0
