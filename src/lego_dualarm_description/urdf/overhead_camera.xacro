<?xml version="1.0"?>
<!--
  Overhead RGB-D camera: Intel RealSense D435 geometry (realsense2_description)
  on a post-and-boom mount beside the table, looking straight down.

  Simulation: Gazebo rgbd_camera sensor on the colour frame, gz topic prefix
  "camera" (camera/image, camera/depth_image, camera/points, camera/camera_info),
  bridged to ROS by lego_dualarm_bringup.

  Parameters roughly follow the D435 colour stream at 640x480: 69.4 deg HFOV.
  Depth clip 0.1-3.0 m (real D435 min range ~0.1-0.2 m).
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro"/>

  <!-- x, y: camera position over the table (world frame); height: lens height above the floor;
       post_y: where the mount post stands (outside the table edge) -->
  <xacro:macro name="overhead_camera" params="parent name x y height post_y sim_gz update_rate:=15">
    <xacro:property name="post_r" value="0.025"/>
    <xacro:property name="boom_z" value="${height + 0.06}"/>
    <xacro:property name="boom_len" value="${max(post_y - y, y - post_y)}"/>

    <!-- Post from the floor to the boom -->
    <joint name="${name}_post_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_post"/>
      <origin xyz="${x} ${post_y} 0"/>
    </joint>
    <link name="${name}_post">
      <visual>
        <origin xyz="0 0 ${boom_z/2}"/>
        <geometry><cylinder radius="${post_r}" length="${boom_z}"/></geometry>
        <material name="mount_grey"><color rgba="0.3 0.3 0.32 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 ${boom_z/2}"/>
        <geometry><cylinder radius="${post_r}" length="${boom_z}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${boom_z/2}"/>
        <mass value="5.0"/>
        <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
      </inertial>
    </link>

    <!-- Horizontal boom from the post top to above the camera -->
    <joint name="${name}_boom_joint" type="fixed">
      <parent link="${name}_post"/>
      <child link="${name}_boom"/>
      <origin xyz="0 ${(y - post_y)/2} ${boom_z}"/>
    </joint>
    <link name="${name}_boom">
      <visual>
        <geometry><box size="0.04 ${boom_len + 2*post_r} 0.04"/></geometry>
        <material name="mount_grey"><color rgba="0.3 0.3 0.32 1"/></material>
      </visual>
      <collision>
        <geometry><box size="0.04 ${boom_len + 2*post_r} 0.04"/></geometry>
      </collision>
      <inertial>
        <mass value="1.0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
      </inertial>
    </link>

    <!-- D435 hanging under the boom, x axis (optical axis) pointing down -->
    <xacro:sensor_d435 parent="${parent}" name="${name}" use_nominal_extrinsics="true">
      <!-- pitch: optical axis down; yaw: long image axis along the table length (world x) -->
      <origin xyz="${x} ${y} ${height}" rpy="0 ${pi/2} ${pi/2}"/>
    </xacro:sensor_d435>

    <xacro:if value="${sim_gz}">
      <gazebo reference="${name}_color_frame">
        <sensor name="${name}" type="rgbd_camera">
          <always_on>true</always_on>
          <update_rate>${update_rate}</update_rate>
          <visualize>false</visualize>
          <topic>${name}</topic>
          <gz_frame_id>${name}_color_optical_frame</gz_frame_id>
          <camera>
            <horizontal_fov>1.2112</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>3.0</far>
            </clip>
            <depth_camera>
              <clip>
                <near>0.1</near>
                <far>3.0</far>
              </clip>
            </depth_camera>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.005</stddev>
            </noise>
          </camera>
        </sensor>
      </gazebo>
    </xacro:if>
  </xacro:macro>

</robot>
