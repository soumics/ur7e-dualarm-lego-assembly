<?xml version="1.0"?>
<!-- Static workcell geometry shared by all arms. Part of the robot description so
     MoveIt's collision model and Gazebo see the same table. -->
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="workcell_table" params="parent length width height">
    <joint name="table_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="table"/>
      <origin xyz="0 0 0"/>
    </joint>

    <!-- Link origin at floor level, table centre; top surface at z = height -->
    <link name="table">
      <visual>
        <origin xyz="0 0 ${height/2}"/>
        <geometry><box size="${length} ${width} ${height}"/></geometry>
        <material name="table_wood"><color rgba="0.72 0.58 0.42 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 ${height/2}"/>
        <geometry><box size="${length} ${width} ${height}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${height/2}"/>
        <mass value="50.0"/>
        <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
      </inertial>
    </link>

    <gazebo reference="table">
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
    </gazebo>
  </xacro:macro>

</robot>
