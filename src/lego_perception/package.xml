<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lego_perception</name>
  <version>0.1.0</version>
  <description>LEGO brick perception: ground-truth backend first, RGB-D detection later.</description>
  <maintainer email="soumic4it@gmail.com">Soumic Sarkar</maintainer>
  <license>Proprietary</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>lego_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>gz_transport_vendor</exec_depend>
  <exec_depend>gz_msgs_vendor</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
